model FacebookIntegration {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  legacyMongoId             String?  @unique @map("legacy_mongo_id")
  pageId                    String   @map("page_id")
  appId                     String   @map("app_id")
  verifyTokenSecretName     String   @map("verify_token_secret_name")
  appSecretName             String   @map("app_secret_name")
  pageAccessTokenSecretName String   @map("page_access_token_secret_name")
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inboundLeads FacebookInboundLead[]

  @@unique([organizationId, pageId])
  @@map("facebook_integrations")
}

model FacebookInboundLead {
  id                  String             @id @default(uuid()) @db.Uuid
  organizationId      String             @map("organization_id") @db.Uuid
  integrationId       String             @map("integration_id") @db.Uuid
  acceptedByProfileId String?            @map("accepted_by_profile_id") @db.Uuid
  convertedLeadId     String?            @unique @map("converted_lead_id") @db.Uuid
  legacyMongoId       String?            @unique @map("legacy_mongo_id")
  providerLeadId      String             @map("provider_lead_id")
  eventTitle          String             @default("Facebook Lead") @map("event_title")
  fieldData           Json               @map("field_data") @db.JsonB
  rawPayload          Json?              @map("raw_payload") @db.JsonB
  status              FacebookLeadStatus @default(PENDING)
  providerCreatedAt   DateTime           @map("provider_created_at") @db.Timestamptz(6)
  expiresAt           DateTime?          @map("expires_at") @db.Timestamptz(6)
  acceptedAt          DateTime?          @map("accepted_at") @db.Timestamptz(6)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration   FacebookIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  acceptedBy    Profile?            @relation("FacebookLeadAcceptor", fields: [acceptedByProfileId], references: [id], onDelete: SetNull)
  convertedLead Lead?               @relation("FacebookConvertedLead", fields: [convertedLeadId], references: [id], onDelete: SetNull)
  claims        FacebookLeadClaim[]

  @@unique([organizationId, providerLeadId])
  @@index([organizationId, status, expiresAt])
  @@map("facebook_inbound_leads")
}

model FacebookLeadClaim {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  inboundLeadId  String              @map("inbound_lead_id") @db.Uuid
  profileId      String              @map("profile_id") @db.Uuid
  status         FacebookClaimStatus @default(PENDING)
  respondedAt    DateTime?           @map("responded_at") @db.Timestamptz(6)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inboundLead  FacebookInboundLead @relation(fields: [inboundLeadId], references: [id], onDelete: Cascade)
  profile      Profile             @relation("FacebookClaimProfile", fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([inboundLeadId, profileId])
  @@index([organizationId, profileId, status])
  @@map("facebook_lead_claims")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorProfileId String?  @map("actor_profile_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?    @db.JsonB
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        Profile?     @relation("AuditActor", fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([actorProfileId, createdAt])
  @@map("audit_logs")
}
