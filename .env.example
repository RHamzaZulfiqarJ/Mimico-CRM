# Public application configuration
NEXT_PUBLIC_APP_URL=https://crm.mimico.live
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only database and Supabase credentials
# DATABASE_URL should use the transaction pooler for the deployed application.
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
# DIRECT_URL is used only by migration, backup, and operator tooling.
DIRECT_URL=postgresql://user:password@host:5432/postgres
SUPABASE_SECRET_KEY=your-server-secret-key

# Scheduled job authentication (generate independent values of 32+ characters)
TASK_REMINDER_SECRET=replace-with-a-unique-32-character-secret
FACEBOOK_MAINTENANCE_SECRET=replace-with-another-unique-32-character-secret

# Optional Facebook integration values. Leave unset while the integration is paused.
# FACEBOOK_GRAPH_API_VERSION=v23.0
# FACEBOOK_VERIFY_TOKEN=
# FACEBOOK_APP_SECRET=
# FACEBOOK_PAGE_ACCESS_TOKEN=
